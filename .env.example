# === LLM API Keys (tuyệt đối không commit .env lên Git) ===
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# === Qdrant Cloud Free Tier (0 MB RAM trên Laptop) ===
QDRANT_MODE=cloud
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_LOCAL_PATH=./data/qdrant_local

# === Local Python Services (KHÔNG cần Docker Desktop) ===
MCP_TRANSPORT=streamable-http
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
API_BASE_URL=http://127.0.0.1:8000

# === Observability (0-Docker: dùng Cloud OTLP hoặc `uv run phoenix serve` cục bộ) ===
ENABLE_TRACING=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_API_KEY=

# === SQLite & Audit Paths ===
PAPERS_DB_PATH=./data/sqlite/papers.db
CHECKPOINTS_DB_PATH=./data/sqlite/checkpoints.db
AUDIT_LOG_PATH=./logs/mcp_audit.jsonl
